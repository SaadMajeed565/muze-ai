{
  "manifest_version": 3,
  "name": "Muze AI",
  "version": "0.6.0",
  "description": "Connect your browser to Claude and other AI clients over MCP.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Muze AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "options_page": "index.html",
  "permissions": [
    "alarms",
    "tabs",
    "tabGroups",
    "webNavigation",
    "scripting",
    "storage",
    "downloads",
    "bookmarks",
    "history",
    "clipboardRead",
    "clipboardWrite",
    "offscreen",
    "sidePanel",
    "identity",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-agent.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
